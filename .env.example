# ─────────────────────────────────────────────────────────────
# Expressa Landing Page — Environment Variables
# Salin file ini ke .env dan isi dengan nilai yang sesuai
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/expressa_db?schema=public"

# Admin secret untuk signing JWT token (ganti dengan string random panjang)
ADMIN_SECRET="ganti_dengan_secret_panjang_dan_random_minimal_32_karakter"

# Port server (opsional, default: 3000)
PORT=3000

# Node environment
NODE_ENV=production
