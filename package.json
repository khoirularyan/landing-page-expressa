{
  "name": "landing-page-expressa",
  "version": "1.0.0",
  "description": "Interactive Landing Page for Expressa - Technology That Works Your Way",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && node prisma/seed.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "expressa",
    "landing-page",
    "nodejs",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "Expressa Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  }
}
